<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Route_AC4</RootNamespace>
    <AssemblyName>Route-AC4</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Shown in the plugin list and compared against the latest release. Bump on every release. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: the host app already ships Route-Plugin-Base.dll, a second copy would break type identity. -->
    <ProjectReference Include="C:\Users\jjdom\OneDrive\Route tracker\Route Tracker(DeathHound)\Route-Plugin-Base\Route-Plugin-Base.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- ACSaveLib is copied next to the plugin (the host does not ship it). -->
    <ProjectReference Include="C:\Users\jjdom\OneDrive\ACSaveLib\src\AcSaveLib\AcSaveLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Routes\**\*.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
